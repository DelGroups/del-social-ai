# DEL SOCIAL AI — environment template
# cp .env.example .env   then fill in every CHANGE_ME. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- App ---
APP_ENV=production            # development | staging | production
LOG_LEVEL=info
SECRET_KEY=CHANGE_ME          # session/JWT signing key (32+ random bytes)
ALLOWED_ORIGINS=https://app.del-groups.com

# --- Edge (Caddy) ---
# Each needs a DNS A record -> VPS IP. Local dev: app.localhost / api.localhost / ai.localhost
APP_DOMAIN=app.del-groups.com  # panel
API_DOMAIN=api.del-groups.com  # API, webhooks, media
AI_DOMAIN=ai.del-groups.com    # redirects to APP_DOMAIN
ACME_EMAIL=info@del-groups.com  # Let's Encrypt expiry notices

# --- PostgreSQL ---
POSTGRES_USER=delsocial
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=delsocial
POSTGRES_PORT=5432            # host port, bound to 127.0.0.1 only
# Used by the api when running on the host (inside Docker it is overridden to host "postgres")
DATABASE_URL=postgresql+asyncpg://delsocial:CHANGE_ME@localhost:5432/delsocial
# Restricted runtime role the api connects as (RLS enforced). Created by migration 0001;
# enable login once:  ALTER ROLE del_app LOGIN PASSWORD '<APP_DB_PASSWORD>'
APP_DB_USER=del_app
APP_DB_PASSWORD=CHANGE_ME
# Alembic migrations run as the database owner (see docs/decisions/001-multi-tenant-rls.md)
MIGRATION_DATABASE_URL=postgresql+asyncpg://delsocial:CHANGE_ME@localhost:5432/delsocial
# pytest only: a throwaway DB whose name contains "test" (tests insert and delete rows)
TEST_DATABASE_URL=postgresql+asyncpg://delsocial:CHANGE_ME@localhost:5432/delsocial_test

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379               # host port, bound to 127.0.0.1 only
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=CHANGE_ME   # https://console.anthropic.com/settings/keys
CLAUDE_MODEL=claude-opus-5-5  # main generation model
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001  # cheap classification/routing
CLAUDE_MAX_TOKENS=4096

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=https://api.del-groups.com
