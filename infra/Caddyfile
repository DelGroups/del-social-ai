# DEL SOCIAL AI — edge proxy
#   APP_DOMAIN  app.del-groups.com  → Next.js panel
#   API_DOMAIN  api.del-groups.com  → FastAPI (API, webhooks, media)
#   AI_DOMAIN   ai.del-groups.com   → redirects to the panel
# For local dev use app.localhost / api.localhost / ai.localhost (self-signed TLS).

{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Proxy liveness check (does not touch upstreams)
	handle /healthz {
		respond "ok" 200
	}

	log {
		output stdout
		format json
	}
}

{$APP_DOMAIN:app.del-groups.com} {
	import common

	handle {
		reverse_proxy web:3000
	}
}

{$API_DOMAIN:api.del-groups.com} {
	import common

	handle {
		reverse_proxy api:8000
	}
}

{$AI_DOMAIN:ai.del-groups.com} {
	import common

	handle {
		redir https://{$APP_DOMAIN:app.del-groups.com}{uri} permanent
	}
}
